{
  "name": "@anjishnusengupta/ny-cli",
  "version": "7.0.0",
  "type": "module",
  "description": "Beautiful terminal anime streaming CLI with Ink UI, artwork display, and cloud sync",
  "main": "backend.mjs",
  "bin": {
    "ny-cli": "bin/ny-cli.mjs"
  },
  "scripts": {
    "sync-version": "node scripts/sync-version.js",
    "check:versions": "node scripts/check-versions.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "version": "node scripts/sync-version.js && npm run build:fallback && node scripts/check-bundle.mjs && git add PKGBUILD ny-cli.spec debian/changelog cli-terminal-fallback.mjs",
    "prepublishOnly": "npm run check:versions && node scripts/check-bundle.mjs",
    "start": "node backend.mjs",
    "cli": "bun cli-terminal.tsx",
    "cli:fallback": "node cli-terminal-fallback.mjs",
    "build:fallback": "node scripts/build-bundle.mjs",
    "postinstall": "echo '\\nRun ny-cli to start watching anime!\\n'"
  },
  "keywords": [
    "anime",
    "cli",
    "ink",
    "terminal-ui",
    "streaming",
    "tui",
    "artwork",
    "firebase"
  ],
  "author": "Anjishnu Sengupta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnjishnuSengupta/ny-cli.git"
  },
  "homepage": "https://nyanime.qzz.io",
  "bugs": {
    "url": "https://github.com/AnjishnuSengupta/ny-cli/issues"
  },
  "files": [
    "bin/",
    "providers/",
    "backend.mjs",
    "cli-terminal-fallback.mjs",
    "config.mjs",
    "dns.mjs",
    "doctor.mjs",
    "net.mjs",
    "npm-shrinkwrap.json",
    "paths.mjs",
    "skip.mjs",
    "swr-cache.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.18.0"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "dependencies": {
    "express": "^5.1.0",
    "impit": "^0.14.6",
    "ink": "^5.2.1",
    "ink-picture": "^1.3.5",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "undici": "^6.29.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.14",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.2"
  }
}
