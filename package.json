{
  "name": "@anjishnusengupta/ny-cli",
  "version": "6.1.0",
  "type": "module",
  "description": "Beautiful terminal anime streaming CLI with Ink UI, artwork display, and cloud sync",
  "main": "backend.mjs",
  "bin": {
    "ny-cli": "ny-cli"
  },
  "scripts": {
    "sync-version": "node scripts/sync-version.js",
    "start": "node backend.mjs",
    "cli": "bun cli-terminal.tsx",
    "cli:fallback": "node cli-terminal-fallback.mjs",
    "build:fallback": "esbuild cli-terminal.tsx --bundle --platform=node --format=esm --outfile=cli-terminal-fallback.mjs --external:react --external:ink --external:ink-text-input --external:ink-picture",
    "test": "node -e \"console.log('No automated tests configured')\"",
    "postinstall": "echo '\\nRun ny-cli to start watching anime!\\n'"
  },
  "keywords": [
    "anime",
    "cli",
    "ink",
    "terminal-ui",
    "streaming",
    "tui",
    "artwork",
    "firebase"
  ],
  "author": "Anjishnu Sengupta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnjishnuSengupta/ny-cli.git"
  },
  "homepage": "https://nyanime.qzz.io",
  "bugs": {
    "url": "https://github.com/AnjishnuSengupta/ny-cli/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "overrides": {
    "ip-set": "^2.2.0"
  },
  "dependencies": {
    "ansi-regex": "^6.2.2",
    "chalk": "^5.6.2",
    "express": "^5.1.0",
    "ink": "^5.2.1",
    "ink-picture": "^1.3.5",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "open": "^11.0.0",
    "react": "^18.3.1",
    "react-devtools-core": "^4.28.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.14",
    "esbuild": "^0.28.1",
    "npm-force-resolutions": "^0.0.10",
    "typescript": "^6.0.2"
  }
}
